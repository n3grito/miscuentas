APP_NAME="MisCuentas"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mis-cuentas.tallerssh.cu

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=miscuentas
DB_USERNAME=miscuentas_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=miscuentas_

MAIL_MAILER=smtp
MAIL_HOST=mail.tallerssh.cu
MAIL_PORT=587
MAIL_USERNAME=noreply@tallerssh.cu
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@tallerssh.cu
MAIL_FROM_NAME="${APP_NAME}"

# Backup
BACKUP_NOTIFY_EMAIL=admin@tallerssh.cu
BACKUP_SLACK_WEBHOOK=

# Auditoría
AUDIT_RETENTION_DAYS=180
